{
  "expo": {
    "name": "MyBizMate Scan",
    "slug": "mybizmate-scan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.VIBRATE"
      ],
      "package": "com.mybizmate.scan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-windows-native-paths",
      "./plugins/with-config-changes",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 104,
          "backgroundColor": "#FCFAF6"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The scanner needs the camera to see the invoice. Nothing it sees leaves the phone.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "SchibstedGrotesk",
                "fontDefinitions": [
                  { "path": "./assets/fonts/SchibstedGrotesk-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/SchibstedGrotesk-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/SchibstedGrotesk-ExtraBold.ttf", "weight": 800 }
                ]
              },
              {
                "fontFamily": "IBMPlexMono",
                "fontDefinitions": [
                  { "path": "./assets/fonts/IBMPlexMono-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/IBMPlexMono-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/IBMPlexMono-SemiBold.ttf", "weight": 600 }
                ]
              }
            ]
          }
        }
      ]
    ],
    "scheme": "mybizmatescan"
  }
}
