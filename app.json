{
  "expo": {
    "name": "MyBizMate Scan",
    "slug": "mybizmate-scan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false,
      "package": "com.mybizmate.scan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-windows-native-paths",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-logo.png",
          "imageWidth": 104,
          "backgroundColor": "#FAF7F0"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The scanner needs the camera to see the invoice. Nothing it sees leaves the phone.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "mybizmatescan"
  }
}
