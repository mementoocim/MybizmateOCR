+  expect(countLine(one)).toBe('1 invoice');
+  const pdf = (n: number) => scanOf('sales_text_0', { session: 'P', source: 'pdf', label: 'PDF: a.pdf', at: at(24, 9, n) });
+  expect(countLine(sessionsOf(membersOf([pdf(1)], []))[0])).toBe('1 PDF');
