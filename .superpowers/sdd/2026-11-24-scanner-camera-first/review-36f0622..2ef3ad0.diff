+  expect(scanBadge(saved(), { kind: 'passed' }, 'changed')).toEqual({ label: 'Changed', tone: 'warning' });
+  // a summary alone
+  expect(scanBadge(membersOf([], [savedSummary(scan.id)!])[0], null, 'unchanged')).toEqual({
