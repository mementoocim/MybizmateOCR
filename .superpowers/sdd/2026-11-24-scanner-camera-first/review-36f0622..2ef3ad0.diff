+  const oldPdf = reloaded(scanOf('sales_text_0', { source: 'pdf', label: 'PDF: sales_text_0.pdf', at: at(23, 16, 10) }));
+  expect(rowTitle(sessionsOf(membersOf([oldPdf], []))[0])).toBe('sales_text_0.pdf 4:10 PM');
